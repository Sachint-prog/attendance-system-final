    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>

        let submit_btn = document.querySelector("#submit");
        submit_btn.addEventListener("click", function (event) {
            event.preventDefault()
    
            let timeperiod = document.querySelector("#timeperiod")
            let timeperiod_value = timeperiod.value

            let date = document.querySelector(".option_3")
            let date_value = date.value
            console.log(date_value)
            let day = date_value.split("-")
    
            let url = window.location.href
            let url_array = url.split("/")
            let url_info = {
                role: url_array[3],
                faculty: url_array[4],
                course: url_array[5],
            }

            console.log(url_info)


            if (day[2] < 10) {
                let val = day[2].split("0")
                console.log(val[1])

                let date_value = `${day[0]}-${day[1]}-${val[1]}`
                console.log(date_value)

                const xhr = new XMLHttpRequest();
                xhr.open('POST', `/${url_info.role}/${url_info.faculty}/${url_info.course}/get_overview_chart_details`, true)
                xhr.setRequestHeader('Content-type', 'application/json')
                xhr.onload = function () {
                    let data_from_backend = JSON.parse(this.responseText)

                    console.log(data_from_backend)
                    attendance_percentage_chart(data_from_backend)
                    create_table(data_from_backend)
                }
                
                const send_data = JSON.stringify({
                    url: url_info,
                    timeperiod: timeperiod_value,
                    date: date_value
                })
                xhr.send(send_data)
            }
            else{
                const xhr = new XMLHttpRequest();
                xhr.open('POST', `/${url_info.role}/${url_info.faculty}/${url_info.course}/get_overview_chart_details`, true)
                xhr.setRequestHeader('Content-type', 'application/json')
                xhr.onload = function () {
                    let data_from_backend = JSON.parse(this.responseText)

                    console.log(data_from_backend)
                    attendance_percentage_chart(data_from_backend)
                    create_table(data_from_backend)
                }
                
                const send_data = JSON.stringify({
                    url: url_info,
                    timeperiod: timeperiod_value,
                    date: date_value
                })
                xhr.send(send_data)
            }
    
            // const xhr = new XMLHttpRequest();
            // xhr.open('POST', `/${url_info.role}/${url_info.faculty}/${url_info.course}/get_overview_chart_details`, true)
            // xhr.setRequestHeader('Content-type', 'application/json')
