            //     console.log(data_from_backend)
            //     attendance_percentage_chart(data_from_backend)
            //     create_table(data_from_backend)
            // }
            
            // const send_data = JSON.stringify({
            //     url: url_info,
            //     timeperiod: timeperiod_value,
            //     date: date_value
            // })
            // xhr.send(send_data)
        })

        function attendance_percentage_chart(data_from_backend) {
            const ctx = document.getElementById('myChart');
            const stackedBar = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: ['IT', 'CE', 'CIVIL', 'MECH', 'AUTO', 'CHEMICAL', 'EC', 'EE'],
                    datasets: [
                        {
                            label: 'sem 2',
                            data: data_from_backend.sem_2,
                            borderWidth: 1,
                            backgroundColor: 'rgba(74,85,150,255)',
                            stack: 'stack 0'
                        },
                        {
                            label: 'sem 4',
                            data: data_from_backend.sem_4,
                            borderWidth: 1,
                            backgroundColor: 'rgba(44,51,101,255)',
                            stack: 'stack 1'
                        },
                        {
                            label: 'sem 6',
                            data: data_from_backend.sem_6,
                            borderWidth: 1,
                            backgroundColor: 'rgba(17,21,57,255)',
                            stack: 'stack 2'
                        },

                    ]
                },
                options: {
                    scales: {
                        x: {
                            stacked: true
                        },
                        y: {
                            stacked: true
                        }
                    },
                    scales: {
                        y: {
                            suggestedMin: 50,
                            suggestedMax: 100,
                            ticks: {
                                // Include a dollar sign in the ticks
                                callback: function (value, index, ticks) {
                                    return value + '%';
                                }
                            }
                        }
                    }
                }
            });
        }


        function create_table(data_from_backend) {
            let branch = ['IT', 'CE', 'CIVIL', 'MECH', 'AUTO', 'CHEMICAL', 'EC', 'EE']

            let  table = document.querySelector("table");
            table.innerHTML = ``
            let table_body = document.createElement("tbody");
            table_body.innerHTML = `
            <tr>
                <th class='srno'>srno</th>
                <th class='branch'>branch</th>
                <th class='sem2'>sem2</th>
                <th class='sem4'>sem4</th>
                <th class='sem6'>sem6</th>
            </tr>
            `;

            for(let i = 0; i < 8; i++){
            console.log(i)
            table_body.innerHTML += `
              <tr>
                <td class='srno'>${i + 1}</td>
                <td class='branch'>${branch[i]}</td>
                <td class='sem2'>${data_from_backend.sem_2[i]} %</td>
                <td class='sem4'>${data_from_backend.sem_4[i]} %</td>
                <td class='sem6'>${data_from_backend.sem_6[i]} %</td>
              </tr>
            `;
          }

          table.appendChild(table_body);
        }


        function exportTableToExcel(tableId) {
            const table = document.getElementById(tableId);
            const html = table.outerHTML;
            const blob = new Blob([html], {type: 'application/vnd.ms-excel'});
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');

            a.href = url;
            a.download = 'table.xls';
            a.click();  
            URL.revokeObjectURL(url);
        }
        
        document.getElementById('exportButton').addEventListener('click', function() {
            exportTableToExcel('tableId');
        });
    </script>

