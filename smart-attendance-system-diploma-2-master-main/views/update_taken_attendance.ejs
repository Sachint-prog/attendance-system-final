<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Update Attendance</title>
    <link rel="shortcut icon" href="/img/favicon.png" type="image/x-icon">
    <link
      href="https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="/css/update_taken_attendance.css" />
    <style>
      .page_box{
        position: absolute;
      }
    </style>
    <style>
      footer{
          position: absolute;
          left: 0;
          bottom: -50%;
          width: 100%;
      }
      .container_footer {
          background-color: #333;
          display: flex;
          justify-content: space-around;
          align-items: center;
      }
      .footer {
          background-color: #333;
          color: #fff;
          padding-top: 40px;
          height: 300px;
      }
      .logo img {
          max-width: 100px;
      }
      .introduction {
          max-width: 400px;
          padding: 25px;
      }
      .contact_us {
          /* border: 1px solid #fff; */
          max-width: 300px;
      }
      .contact_us h1 {
          font-size: 24px;
          margin-bottom: 15px;
      }
      .social_media {
          background-color: #333;
          color: #fff;
          display: flex;
          align-items: center;
          justify-content: center;
          padding-top: 20px;
      }
      .social_media i {
          font-size: 24px;
          color: #fff;
          margin: 0 10px;
          transition: color 0.3s;
      }
      .social_media i:hover {
          color: #ffd700; 
      }
  </style>
  </head>
  <body>
    <a href="/<%=user_id.role%>"><i class="bx bxs-home"></i></a>

    <% if(attendance == "no"){ %>

      <form
        class="form"
        action="/<%=user_id.role%>/<%=info.faculty%>/<%=info.course%>/<%=info.branch%>/getUpdateTable"
        method="post"
      >
        <input type="date" name="datetime" id="datetime" placeholder="datetime" class="option_3">
        <select class="option_1" name="sem" id="sem">
          <option value="">select a semister</option>
          <% for(let i = 0; i < sem.length; i++){ %>
          <option value="<%= sem[i].sem %>"><%= sem[i].sem %></option>
          <% } %>
        </select>
        <select class="option_2" name="subject" id="subject">
          <option value="">select a subject</option>
        </select>
        <div class="lecture_container">
          <div class="lecture_1">
              <input type="checkbox" name="lecture" id="lecture_1" value="1" />
              <label for="lecture_1">Lecture 1</label>
          </div>
          <div class="lecture_2">
              <input type="checkbox" name="lecture" id="lecture_2" value="2" />
              <label for="lecture_2">Lecture 2</label>
          </div>
          <div class="lecture_3">
              <input type="checkbox" name="lecture" id="lecture_3" value="3" />
              <label for="lecture_3">Lecture 3</label>
          </div>
          <div class="lecture_4">
              <input type="checkbox" name="lecture" id="lecture_4" value="4" />
              <label for="lecture_4">Lecture 4</label>
          </div>
          <div class="lecture_5">
              <input type="checkbox" name="lecture" id="lecture_5" value="5" />
              <label for="lecture_5">Lecture 5</label>
          </div>
          <div class="lecture_6">
              <input type="checkbox" name="lecture" id="lecture_6" value="6" />
              <label for="lecture_6">Lecture 6</label>
          </div>
        </div>
        <button class="log_btn_1" type="submit" id="submit_btn">submit</button>
      </form>

      <footer class="footer">
        <div class="container_footer">
            <div class="logo_footer">
                <img src="/img/favicon.png" alt="image" height="100px" width="100px">
