          <option value="<%= form_info.sem %>"><%= form_info.sem %></option>
        </select>
        <select class="option_2" name="subject" id="subject">
          <option value="<%= form_info.subject %>"><%= form_info.subject %></option>
        </select>

        <div class="lecture_container">
          <% for(let i = 0; i < form_info.lectures.length; i++){ %>
            <% if(form_info.lectures[i] != undefined){ %> 
              <div class="<%= form_info.lectures[i] %>">
                  <input class="lecture" checked type="checkbox" name="lecture" id="<%= form_info.lectures[i] %>" value="<%= form_info.lectures[i] %>" />
                  <label for="<%= form_info.lectures[i] %>"><%= form_info.lectures[i] %></label>
              </div>
            <% } %>
          <% } %>
        </div>

        <button class="log_btn_1" type="submit" id="submit_btn">submit</button>
      </form>


      <form
        class="table_"
        id="table_form"
      >
        <table border="">
          <tr>
            <th class="srno">srno</th>
            <th class="checkbox">
              <input type="checkbox" name="selectAll" id="selectAll" />
              <label for="selectAll">selectAll</label>
            </th>
            <th class="en">enrollment no</th>
            <th class="name">name</th>
          </tr>

          <% for(let i = 0; i < attendance.length; i++){ %>
          <tr>
            <td class="srno"><%= attendance[i].sr_no %></td>
            <td class="checkbox">
              <input
                type="checkbox"
                name="<%= attendance[i].Enrollment_no %>"
                class="options"
                id="<%= attendance[i].Enrollment_no %>"
              />
              <label
                id="<%= attendance[i].Enrollment_no %>_label"
                for="<%= attendance[i].Enrollment_no %>"
                class="label_name"
                >p/a</label
              >
            </td>
            <td class="en"><%= attendance[i].Enrollment_no %></td>
            <td class="name"><%= attendance[i].Student_name %></td>
          </tr>
          <% } %>
        </table>

        <div class="p">
          <input type="radio" name="attendance" id="present" value="present" />
          <label for="present">present</label>
        </div>
        <div class="a">
          <input type="radio" name="attendance" id="absent" value="absent" />
          <label for="absent">absent</label>
        </div>
        <button class="log_btn_2" id="reset">reset</button>
        <button class="log_btn_3" type="submit" id="submit">submit</button>
      </form>

