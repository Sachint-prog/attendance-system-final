                <th class='enno'>enrollment no</th>
                <th class='lecture1'>lecture1</th>
                <th class='lecture2'>lecture2</th>
                <th class='lecture3'>lecture3</th>
                <th class='lecture4'>lecture4</th>
                <th class='lecture5'>lecture5</th>
                <th class='lecture6'>lecture6</th>
            </tr>
            `;

            for(let i = 0; i < data_from_backend.student_name.length; i++){
                console.log(i)
                table_body.innerHTML += `
                <tr>
                    <td class='srno'>${i + 1}</td>
                    <td class='name'>${data_from_backend.student_name[i]}</td>
                    <td class='enno'>${data_from_backend.student_en_no[i]}</td>
                    <td class='lecture1'>${data_from_backend.lecture_1[i]}</td>
                    <td class='lecture2'>${data_from_backend.lecture_2[i]}</td>
                    <td class='lecture3'>${data_from_backend.lecture_3[i]}</td>
                    <td class='lecture4'>${data_from_backend.lecture_4[i]}</td>
                    <td class='lecture5'>${data_from_backend.lecture_5[i]}</td>
                    <td class='lecture6'>${data_from_backend.lecture_6[i]}</td>
                </tr>
                `;
            }

            table.appendChild(table_body);
        }


        function exportTableToExcel(tableId) {
            const table = document.getElementById(tableId);
            const html = table.outerHTML;
            const blob = new Blob([html], {type: 'application/vnd.ms-excel'});
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');

            a.href = url;
            a.download = 'table.xls';
            a.click();  
            URL.revokeObjectURL(url);
        }
        
        document.getElementById('exportButton').addEventListener('click', function() {
            exportTableToExcel('tableId');
        });    
    
    </script>
    
</body>
</html>
