        function monthly_student_chart(data_from_backend) {
            const data = {
                    labels: data_from_backend.student_en_no,
                    datasets: [
                        {
                            label: 'attendance percentage',
                            data: data_from_backend.total,
                            borderWidth: 1,
                            backgroundColor: 'rgb(105, 120, 202)',
                        },
                    ]
                };
        
                const widthPerLabel = 100; // Set width per data point
                const totalWidth = data.labels.length * widthPerLabel;
                
                const canvas = document.getElementById('myChart');
                const ctx = canvas.getContext('2d');
                const canvasWrapper = document.getElementById('canvasWrapper');
        
                // Set dynamic width based on the data
                if (totalWidth < 200) {
                    canvasWrapper.style.width = `${200}px`;
                }else{
                    canvasWrapper.style.width = `${totalWidth}px`;
                }
        
                const chart = new Chart(ctx, {
                    type: 'bar',
                    data: data,
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            x: {
                                stacked: true
                            },
                            y: {
                                beginAtZero: true,
                                stacked: true,
                                suggestedMin: 50,
                                suggestedMax: 100,
                                ticks: {
                                    // Include a dollar sign in the ticks
                                    callback: function (value, index, ticks) {
                                        return value + '%';
                                    }
                                }
                            }
                        },
                        plugins: {
                            htmlLegend: {
                                // ID of the container to put the legend in
                                containerID: 'legend-container',
                            },
                            legend: {
                                display: false,
                            }
                        }
                    },
                    plugins: [htmlLegendPlugin],
                });
        }
    
